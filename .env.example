# Copy to .env (git-ignored). `make setup` does this for you.

# --- Discovery (the only step that calls a model; replay never does) ------------------------
ANTHROPIC_API_KEY=
# ROTE_MODEL=claude-opus-5-5        # default
# ROTE_EFFORT=high                  # low | medium | high | xhigh | max
# ROTE_FALLBACKS=1                  # server-side refusal fallback (set 0 to disable)

# --- Intervention routing (optional) --------------------------------------------------------
# ROTE_WEBHOOK_URL=                 # e.g. a Slack/Teams incoming webhook
# ROTE_CONSOLE_PORT=8765

# --- Service-account credentials for the local LegacyCore mock -------------------------------
# Synthetic demo values for the bundled mock app only. Real deployments resolve these from a
# secret store; the tenant files reference them as env:NAME and they never reach the model.
ACME_LEGACYCORE_USERNAME=TELLER01
ACME_LEGACYCORE_PASSWORD=acme-demo-pass
BAYVIEW_LEGACYCORE_USERNAME=OPS_USER
BAYVIEW_LEGACYCORE_PASSWORD=bayview-demo-pass

# --- Control plane stack (docker compose) ---------------------------------------------------
# `make env` appends these with random values; you never need to invent them.
#   POSTGRES_PASSWORD=     the compose Postgres
#   JWT_SECRET=            signs access tokens (>= 32 chars)
#   ENGINE_TOKEN=          shared secret between the backend and the engine
#   SEED_ADMIN_PASSWORD=   password of the seeded admin (SEED_ADMIN_EMAIL, default admin@rote.local)
#   SEED_DEMO_PASSWORD=    password of the seeded reviewer@ / operator@ / viewer@rote.local
# Optional overrides:
# ROTE_HTTP_PORT=3000      host port for the UI + API
# POSTGRES_HOST_PORT=5433  host port for Postgres (bound to 127.0.0.1)
# PUBLIC_URL=http://localhost:3000
# DEMO_ENABLED=true        fault injection + sample members for the bundled mock
