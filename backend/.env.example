# Backend configuration for running outside Docker (`npm run start:dev`).
# `make env` (scripts/ensure-env.sh) creates backend/.env from this file and fills the blank secrets.
# Every variable is validated at startup (src/config/validation.ts): a missing or invalid value stops the app.

# --- Runtime ---------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Base URL users reach the UI on; used in links handed to agents and operators.
PUBLIC_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API cross-origin. The UI is same-origin, so this is
# only for other front-ends. Empty = no cross-origin access.
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the app (for client IPs and rate limits). 0 = none.
TRUST_PROXY=0

# --- Database --------------------------------------------------------------------------------------------
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# --- Authentication --------------------------------------------------------------------------------------
# At least 32 characters of randomness. Rotating it signs every user out.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# true behind TLS (the production default). Plain-http localhost needs false.
COOKIE_SECURE=false
AUTH_ALLOW_SIGNUP=true
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Four-eyes rule: whoever started the discovery that recorded a draft cannot approve it.
APPROVAL_REQUIRE_SEPARATE_REVIEWER=true

# --- Engine (the Python rote engine: `make engine`) ------------------------------------------------------
ENGINE_URL=http://127.0.0.1:8700
ENGINE_TOKEN=
ENGINE_TIMEOUT_MS=15000
ENGINE_ALLOW_HEADED=true
RUN_SYNC_ENABLED=true
RUN_SYNC_INTERVAL_MS=5000

# --- Features & limits -----------------------------------------------------------------------------------
# Demo controls for the bundled LegacyCore mock (fault injection, sample members). false in production.
DEMO_ENABLED=true
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
# The built UI (ui/dist) to serve at /. Empty disables UI hosting (e.g. when using `npm run dev` in ui/).
UI_DIST_PATH=../ui/dist

# --- Seed (prisma/seed.ts only; never read by the running app) -----------------------------------------
SEED_ADMIN_EMAIL=admin@rote.local
SEED_ADMIN_NAME=Rote Admin
SEED_ADMIN_PASSWORD=
# Also create reviewer@, operator@ and viewer@rote.local, all with SEED_DEMO_PASSWORD.
SEED_DEMO_USERS=true
SEED_DEMO_PASSWORD=
